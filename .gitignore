# Что никогда не должно попасть в публичный репозиторий.
# Правила нарочно широкие: слой публикуется по списку разрешённого, а этот файл
# ловит случайное `git add` в обход списка.

# Секреты и местные настройки
.env
.env.*
config.yaml
config.local.yaml
*.pem
*.key
*.p12
*.pfx

# Рабочие каталоги и данные Coddy
Max-in/
sessions/
skills-delivery.json
.coddy/

# Сборка и её следы. Пути с косой чертой в начале — только в корне пакета:
# без них правило «coddy» накрывало каталог overlay/cmd/coddy и выкидывало
# три файла слоя из публикации.
build/
/coddy
/coddy.exe
*.exe
*.test
*.out

# Служебное рабочее
.publish-allowlist
DOCS_W/
*.log
